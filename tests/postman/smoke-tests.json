{
  "info": {
    "name": "QA-14 Fintech API - Smoke Tests",
    "description": "Automated smoke test collection for the 3MTT QA-14 Smoke Test in CI capstone project.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    }
  ],
  "item": [
    {
      "name": "ST-001 - API Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('ST-001: HTTP status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('ST-001: API status is ok', function () {",
              "    pm.expect(json.status).to.eql('ok');",
              "});",
              "",
              "pm.test('ST-001: Service name is correct', function () {",
              "    pm.expect(json.service).to.eql('QA-14 Fintech API');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "ST-002 - Valid Login",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"testuser@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "login"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('ST-002: HTTP status is 200', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "const json = pm.response.json();",
              "",
              "pm.test('ST-002: Login is successful', function () {",
              "    pm.expect(json.success).to.eql(true);",
              "});",
              "",
              "pm.test('ST-002: Authentication token exists', function () {",
              "    pm.expect(json.token).to.be.a('string').and.not.empty;",
              "});",
              "",
              "pm.test('ST-002: Correct user email returned', function () {",
              "    pm.expect(json.user.email).to.eql('testuser@example.com');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
